---
// 1〜12月の記録件数をヒートマップ風に表示
interface Props { counts: number[]; max?: number }
const { counts, max = Math.max(1, ...counts) } = Astro.props;
const level = (n: number) => (n === 0 ? 0 : Math.min(4, Math.ceil((n / max) * 4)));
---
<span class="heat" role="img" aria-label={counts.map((n, i) => `${i + 1}月 ${n}件`).join('、')}>
  {counts.map((n, i) => <span class={`cell l${level(n)}`} title={`${i + 1}月: ${n}件`}></span>)}
</span>
<style>
  .heat { display: inline-grid; grid-template-columns: repeat(12, 1rem); gap: 2px; vertical-align: middle; }
  .cell { width: 1rem; height: 1rem; border-radius: 2px; background: var(--heat-0); }
  .l1 { background: var(--heat-1); } .l2 { background: var(--heat-2); } .l3 { background: var(--heat-3); } .l4 { background: var(--heat-4); }
</style>
